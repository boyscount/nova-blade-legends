/* Nova Blade UI theme: scroll bars in the game's gold-on-dark style (thin dark track, gold thumb, no arrow buttons). Loaded by Ui.Awake. */
.unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.unity-scroller--vertical {
    width: 12px;
    margin-left: 4px;
}
.unity-scroller--horizontal {
    height: 16px;
    margin-top: 4px;
}
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}
.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(18, 12, 6, 0.8);
    border-color: rgba(217, 168, 82, 0.75);
    border-width: 1px;
    border-radius: 6px;
}
.unity-scroller .unity-base-slider__dragger {
    background-color: rgb(196, 146, 58);
    border-color: rgb(255, 222, 150);
    border-width: 1px;
    border-radius: 5px;
}
.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(230, 182, 88);
}
.unity-scroller .unity-base-slider__dragger:active {
    background-color: rgb(255, 208, 112);
}
.unity-scroller--vertical .unity-base-slider__tracker {
    width: 8px;
    left: 2px;
}
.unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    left: 2px;
}
.unity-scroller--horizontal .unity-base-slider__tracker {
    height: 10px;
    top: 2px;
}
.unity-scroller--horizontal .unity-base-slider__dragger {
    height: 10px;
    top: 2px;
}
